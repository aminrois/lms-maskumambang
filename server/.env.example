PORT=5000
NODE_ENV=development

# PostgreSQL Connection String (Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lms_db?schema=public"

# JWT Secret
JWT_SECRET="super-secret-jwt-key-change-this-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"

# CORS Origin (Frontend URL)
CORS_ORIGIN="http://localhost:5173"
