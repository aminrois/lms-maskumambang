generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  user_id          String      @id @default(uuid()) @db.Uuid
  username         String      @unique
  email            String?     @unique
  password_hash    String
  fcm_device_token String?
  created_at       DateTime    @default(now())

  user_roles       UserRole[]
  pegawai          Pegawai[]
  wali_murid       WaliMurid[]

  @@map("users")
}

model Role {
  role_id    Int        @id @default(autoincrement())
  nama_role  String     @unique // 'Super Admin' | 'Direktur' | 'Kepala Sekolah' | 'Admin Lembaga' | 'WaKa Kurikulum' | 'Wali Kelas' | 'Guru' | 'Guru Tahfidz' | 'Wali Murid'
  user_roles UserRole[]

  @@map("roles")
}

model UserRole {
  user_role_id Int      @id @default(autoincrement())
  user_id      String   @db.Uuid
  role_id      Int
  lembaga_id   Int?

  user         User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  role         Role     @relation(fields: [role_id], references: [role_id], onDelete: Cascade)
  lembaga      Lembaga? @relation(fields: [lembaga_id], references: [lembaga_id], onDelete: SetNull)

  @@unique([user_id, role_id, lembaga_id])
  @@index([user_id])
  @@index([lembaga_id])
  @@map("user_roles")
}

model Lembaga {
  lembaga_id        Int        @id @default(autoincrement())
  nama_lembaga      String
  singkatan         String?
  kepala_sekolah_id Int?
  kurikulum_id      Int?

  user_roles        UserRole[]
  pegawai_lembaga   PegawaiLembaga[]
  tahun_ajaran      TahunAjaran[]
  kelas             Kelas[]
  mata_pelajaran    MataPelajaran[]
  jam_akademik      JamAkademik[]
  kalender_akademik KalenderAkademik[]
  activity_plan     ActivityPlan[]
  tahfidz_pengampu  TahfidzPengampu[]
  tahfidz_halaqah   TahfidzHalaqah[]
  pos_pembayaran    PosPembayaran[]
  rekening_pesantren RekeningPesantren[]

  @@map("lembaga")
}

model Pegawai {
  pegawai_id              Int              @id @default(autoincrement())
  user_id                 String?          @db.Uuid
  nig                     String           @unique
  nip                     String?
  nik                     String?
  nama                    String
  jenis_kelamin           String           // 'L' | 'P'
  tempat_lahir            String?
  tanggal_lahir           String?
  alamat                  String?
  no_hp                   String?
  status                  String           @default("Aktif") // 'Aktif' | 'Tidak Aktif'
  jabatan                 String
  tugas_tambahan          String?
  jumlah_anak_laki        Int?             @default(0)
  jumlah_anak_perempuan   Int?             @default(0)
  nama_ayah               String?
  nama_ibu                String?
  golongan_darah          String?

  user                    User?            @relation(fields: [user_id], references: [user_id], onDelete: SetNull)
  pegawai_lembaga         PegawaiLembaga[]
  jadwal_pelajaran        JadwalPelajaran[]
  lesson_plans            LessonPlan[]
  kelas_wali              Kelas[]          @relation("WaliKelasRel")
  tahfidz_pengampu        TahfidzPengampu[]
  tahfidz_setoran         TahfidzSetoran[]
  tahfidz_halaqah         TahfidzHalaqah[]

  @@index([user_id])
  @@index([status])
  @@map("pegawai")
}

model PegawaiLembaga {
  pegawai_id Int
  lembaga_id Int

  pegawai    Pegawai @relation(fields: [pegawai_id], references: [pegawai_id], onDelete: Cascade)
  lembaga    Lembaga @relation(fields: [lembaga_id], references: [lembaga_id], onDelete: Cascade)

  @@id([pegawai_id, lembaga_id])
  @@map("pegawai_lembaga")
}

model WaliMurid {
  wali_id             Int      @id @default(autoincrement())
  user_id             String?  @db.Uuid
  nama_ayah           String?
  nik_ayah            String?
  status_ayah         String?  // 'Wafat' | 'Hidup'
  tempat_lahir_ayah   String?
  tanggal_lahir_ayah  String?
  email_ayah          String?
  pin_ayah            String?
  pendidikan_ayah     String?
  pekerjaan_ayah      String?
  penghasilan_ayah    String?
  nama_ibu            String?
  nik_ibu             String?
  status_ibu          String?  // 'Wafat' | 'Hidup'
  tempat_lahir_ibu    String?
  tanggal_lahir_ibu   String?
  email_ibu           String?
  pin_ibu             String?
  pendidikan_ibu      String?
  pekerjaan_ibu       String?
  penghasilan_ibu     String?
  nama_wali           String
  nik_wali            String
  alamat              String
  status              String   // 'Wafat' | 'Hidup'
  no_hp_ayah          String?
  no_hp_ibu           String?
  no_hp_wali          String

  user                User?    @relation(fields: [user_id], references: [user_id], onDelete: SetNull)
  siswa               Siswa[]
  pembayaran_transaksi PembayaranTransaksi[]

  @@map("wali_murid")
}

model Siswa {
  siswa_id            Int               @id @default(autoincrement())
  nis                 String            @unique
  nisn                String            @unique
  nik                 String?
  pin                 String?
  nama                String
  panggilan           String?
  jenis_kelamin       String            // 'L' | 'P'
  tempat_lahir        String
  tanggal_lahir       String
  agama               String            @default("Islam")
  kewarganegaraan     String            @default("Indonesia")
  tahun_masuk         Int
  asal_sekolah        String
  no_un_sebelumnya    String?
  alamat              String?
  kode_pos            String?
  status              String?           @default("Aktif") // 'Aktif' | 'Tidak Aktif'
  keterangan_asrama   String            @default("Tidak") // 'Ya' | 'Tidak'
  wali_murid_id       Int?
  kelas_id            Int?
  no_kk               String?
  no_akta_kelahiran   String?
  rt                  String?
  rw                  String?
  desa_kelurahan      String?
  kecamatan           String?
  kabupaten_kota      String?
  provinsi            String?
  alamat_sekolah_asal String?

  wali_murid          WaliMurid?        @relation(fields: [wali_murid_id], references: [wali_id], onDelete: SetNull)
  kelas               Kelas?            @relation(fields: [kelas_id], references: [kelas_id], onDelete: SetNull)
  absensi_pelajaran   AbsensiPelajaran[]
  absensi_harian      AbsensiHarian[]
  tahfidz_target      TahfidzTarget[]
  tahfidz_setoran     TahfidzSetoran[]
  tahfidz_halaqah_siswa TahfidzHalaqahSiswa[]
  tagihan_siswa       TagihanSiswa[]
  pembayaran_transaksi PembayaranTransaksi[]

  @@index([kelas_id])
  @@index([status])
  @@map("siswa")
}

model TahunAjaran {
  tahun_id          Int                @id @default(autoincrement())
  lembaga_id        Int
  nama_tahun        String
  semester          String             // 'Ganjil' | 'Genap'
  tanggal_mulai     String
  tanggal_akhir     String
  is_active         Boolean            @default(false)

  lembaga           Lembaga            @relation(fields: [lembaga_id], references: [lembaga_id], onDelete: Cascade)
  kelas             Kelas[]
  kalender_akademik KalenderAkademik[]
  activity_plan     ActivityPlan[]
  tahfidz_halaqah   TahfidzHalaqah[]
  pos_pembayaran    PosPembayaran[]
  tagihan_siswa     TagihanSiswa[]

  @@map("tahun_ajaran")
}

model Kelas {
  kelas_id         Int               @id @default(autoincrement())
  lembaga_id       Int
  tahun_id         Int
  nama_kelas       String
  wali_kelas_id    Int?

  lembaga          Lembaga           @relation(fields: [lembaga_id], references: [lembaga_id], onDelete: Cascade)
  tahun_ajaran     TahunAjaran       @relation(fields: [tahun_id], references: [tahun_id], onDelete: Cascade)
  wali_kelas       Pegawai?          @relation("WaliKelasRel", fields: [wali_kelas_id], references: [pegawai_id], onDelete: SetNull)
  siswa            Siswa[]
  kelas_mapel      KelasMapel[]
  jadwal_pelajaran JadwalPelajaran[]
  tahfidz_pengampu TahfidzPengampu[]

  @@index([lembaga_id, tahun_id])
  @@index([wali_kelas_id])
  @@map("kelas")
}

model MataPelajaran {
  mapel_id         Int               @id @default(autoincrement())
  lembaga_id       Int
  nama_mapel       String

  lembaga          Lembaga           @relation(fields: [lembaga_id], references: [lembaga_id], onDelete: Cascade)
  kelas_mapel      KelasMapel[]
  jadwal_pelajaran JadwalPelajaran[]

  @@map("mata_pelajaran")
}

model KelasMapel {
  kelas_id Int
  mapel_id Int

  kelas    Kelas         @relation(fields: [kelas_id], references: [kelas_id], onDelete: Cascade)
  mapel    MataPelajaran @relation(fields: [mapel_id], references: [mapel_id], onDelete: Cascade)

  @@id([kelas_id, mapel_id])
  @@map("kelas_mapel")
}

model JamAkademik {
  jam_id         Int               @id @default(autoincrement())
  lembaga_id     Int
  urutan_jam     Int
  jam_mulai      String
  jam_selesai    String
  tipe           String            // 'Belajar' | 'Istirahat' | 'Sholat Dhuha & Halaqoh' | 'Apel' | 'Mapel Pilihan / Bimbingan TKA' | 'Bonding / Life Skill'

  lembaga        Lembaga           @relation(fields: [lembaga_id], references: [lembaga_id], onDelete: Cascade)
  jadwal_mulai   JadwalPelajaran[] @relation("JamMulai")
  jadwal_selesai JadwalPelajaran[] @relation("JamSelesai")

  @@map("jam_akademik")
}

model JadwalPelajaran {
  jadwal_id       Int              @id @default(autoincrement())
  kelas_id        Int?
  mapel_id        Int?
  pegawai_id      Int?
  ruangan         String?
  hari            String           // 'Senin' | 'Selasa' | 'Rabu' | 'Kamis' | 'Jumat' | 'Sabtu' | 'Ahad'
  jam_mulai_id    Int?
  jam_selesai_id  Int?

  kelas           Kelas?           @relation(fields: [kelas_id], references: [kelas_id], onDelete: SetNull)
  mapel           MataPelajaran?   @relation(fields: [mapel_id], references: [mapel_id], onDelete: SetNull)
  pegawai         Pegawai?         @relation(fields: [pegawai_id], references: [pegawai_id], onDelete: SetNull)
  jam_mulai       JamAkademik?     @relation("JamMulai", fields: [jam_mulai_id], references: [jam_id], onDelete: SetNull)
  jam_selesai     JamAkademik?     @relation("JamSelesai", fields: [jam_selesai_id], references: [jam_id], onDelete: SetNull)
  lesson_plans    LessonPlan[]
  jurnal_mengajar JurnalMengajar[]

  @@index([kelas_id])
  @@index([pegawai_id])
  @@index([hari])
  @@map("jadwal_pelajaran")
}

model LessonPlan {
  lesson_plan_id             Int                @id @default(autoincrement())
  pegawai_id                 Int
  jadwal_id                  Int?
  judul_rpp                  String
  status_verifikasi_kepsek   String?            @default("Menunggu Verifikasi") // 'Menunggu Verifikasi' | 'Disetujui' | 'Revisi'
  verified_by_kepsek         Int?
  catatan_revisi_kepsek      String?
  status_verifikasi_direktur String?            @default("Menunggu Verifikasi") // 'Menunggu Verifikasi' | 'Disetujui' | 'Revisi'
  verified_by_direktur       Int?
  catatan_revisi_direktur    String?

  pegawai                    Pegawai            @relation(fields: [pegawai_id], references: [pegawai_id], onDelete: Cascade)
  jadwal                     JadwalPelajaran?   @relation(fields: [jadwal_id], references: [jadwal_id], onDelete: SetNull)
  details                    LessonPlanDetail[]

  @@index([pegawai_id])
  @@index([jadwal_id])
  @@index([status_verifikasi_kepsek])
  @@index([status_verifikasi_direktur])
  @@map("lesson_plan")
}

model LessonPlanDetail {
  detail_id                  Int              @id @default(autoincrement())
  lesson_plan_id             Int
  pertemuan_ke               Int
  materi                     String?
  topik_materi               String?
  rencana_pelaksanaan_kbm    String?
  isi                        String?
  status_verifikasi_kepsek   String?          @default("Menunggu Verifikasi")
  verified_by_kepsek         Int?
  catatan_revisi_kepsek      String?
  status_verifikasi_direktur String?          @default("Menunggu Verifikasi")
  verified_by_direktur       Int?
  catatan_revisi_direktur    String?

  lesson_plan                LessonPlan       @relation(fields: [lesson_plan_id], references: [lesson_plan_id], onDelete: Cascade)
  jurnal_mengajar            JurnalMengajar[]

  @@index([lesson_plan_id])
  @@index([status_verifikasi_kepsek])
  @@index([status_verifikasi_direktur])
  @@map("lesson_plan_detail")
}

model JurnalMengajar {
  jurnal_id              Int                @id @default(autoincrement())
  jadwal_id              Int
  lesson_plan_detail_id  Int?
  pertemuan_ke           Int?
  status                 String?            // 'Tertinggal' | 'Sesuai' | 'Terlalu Cepat'
  tanggal                String
  catatan_tambahan       String?

  jadwal                 JadwalPelajaran    @relation(fields: [jadwal_id], references: [jadwal_id], onDelete: Cascade)
  lesson_plan_detail     LessonPlanDetail?  @relation(fields: [lesson_plan_detail_id], references: [detail_id], onDelete: SetNull)
  absensi_pelajaran      AbsensiPelajaran[]

  @@index([jadwal_id])
  @@index([tanggal])
  @@map("jurnal_mengajar")
}

model AbsensiPelajaran {
  absensi_pel_id   Int            @id @default(autoincrement())
  siswa_id         Int
  jurnal_id        Int
  waktu_kehadiran  String?
  status           String         // 'Hadir' | 'Sakit' | 'Izin' | 'Alpha' | 'Dispen'

  siswa            Siswa          @relation(fields: [siswa_id], references: [siswa_id], onDelete: Cascade)
  jurnal           JurnalMengajar @relation(fields: [jurnal_id], references: [jurnal_id], onDelete: Cascade)

  @@index([siswa_id])
  @@index([jurnal_id])
  @@map("absensi_pelajaran")
}

model AbsensiHarian {
  absensi_harian_id Int    @id @default(autoincrement())
  siswa_id          Int
  tanggal           String
  status            String // 'Hadir' | 'Sakit' | 'Izin' | 'Alpha' | 'Dispen'

  siswa             Siswa  @relation(fields: [siswa_id], references: [siswa_id], onDelete: Cascade)

  @@index([siswa_id])
  @@index([tanggal])
  @@map("absensi_harian")
}

model KalenderAkademik {
  kalender_id      Int          @id @default(autoincrement())
  lembaga_id       Int?
  tahun_id         Int
  nama_kegiatan    String
  kategori         String       // 'Akademik' | 'Acara' | 'Libur' | 'Lainnya'
  tanggal_mulai    String
  tanggal_berakhir String

  lembaga          Lembaga?     @relation(fields: [lembaga_id], references: [lembaga_id], onDelete: SetNull)
  tahun_ajaran     TahunAjaran  @relation(fields: [tahun_id], references: [tahun_id], onDelete: Cascade)

  @@map("kalender_akademik")
}

model ActivityPlan {
  activity_id        Int          @id @default(autoincrement())
  lembaga_id         Int
  tahun_id           Int
  nama_kegiatan      String
  kategori           String       // 'Akademik' | 'Acara' | 'Libur' | 'Lainnya'
  tanggal_mulai      String
  tanggal_berakhir   String
  deskripsi          String?
  status_verifikasi  String?      @default("Menunggu Verifikasi") // 'Menunggu Verifikasi' | 'Disetujui' | 'Revisi'
  verified_by        Int?
  catatan_revisi     String?

  lembaga            Lembaga      @relation(fields: [lembaga_id], references: [lembaga_id], onDelete: Cascade)
  tahun_ajaran       TahunAjaran  @relation(fields: [tahun_id], references: [tahun_id], onDelete: Cascade)

  @@map("activity_plan")
}

model TahfidzPengampu {
  pengampu_id   Int        @id @default(autoincrement())
  pegawai_id    Int
  lembaga_id    Int
  kelas_id      Int
  tahun_id      Int?
  created_at    DateTime   @default(now())

  pegawai       Pegawai    @relation(fields: [pegawai_id], references: [pegawai_id], onDelete: Cascade)
  lembaga       Lembaga    @relation(fields: [lembaga_id], references: [lembaga_id], onDelete: Cascade)
  kelas         Kelas      @relation(fields: [kelas_id], references: [kelas_id], onDelete: Cascade)

  @@unique([pegawai_id, kelas_id])
  @@index([pegawai_id])
  @@index([kelas_id])
  @@index([lembaga_id])
  @@map("tahfidz_pengampu")
}

model TahfidzTarget {
  target_id        Int       @id @default(autoincrement())
  siswa_id         Int
  kategori         String    // 'Al-Quran' | 'Hadits' | 'Matan Ilmu'
  target_deskripsi String    // e.g. 'Target 5 Juz (Juz 1-5)', 'Hadits Arbain 42 Hadits'
  target_nominal   Float     // numerical target e.g. 5 for 5 juz / 42 for 42 hadith / 100 for 100 bait
  satuan           String    // 'Juz' | 'Surat' | 'Hadits' | 'Bait' | 'Halaman'
  tanggal_mulai    String
  tanggal_target   String?
  status           String    @default("Aktif") // 'Aktif' | 'Tercapai' | 'Ditunda'
  created_at       DateTime  @default(now())

  siswa            Siswa     @relation(fields: [siswa_id], references: [siswa_id], onDelete: Cascade)

  @@index([siswa_id])
  @@index([kategori])
  @@map("tahfidz_target")
}

model TahfidzSetoran {
  setoran_id         Int       @id @default(autoincrement())
  siswa_id           Int
  pegawai_id         Int       // Guru Tahfidz yang menyimak
  kategori           String    // 'Al-Quran' | 'Hadits' | 'Matan Ilmu'
  jenis_hafalan      String    // 'Setoran Baru' | 'Setoran Ulang' | 'Ujian'
  tanggal            String    // YYYY-MM-DD
  durasi_menit       Int?      // Durasi setoran dalam menit
  kelancaran         String    // 'Sangat Lancar' | 'Lancar' | 'Kurang Lancar' | 'Belum Lancar'
  catatan_guru       String?

  // --- Khusus Al-Qur'an ---
  surat_mulai        Int?      // Nomor surat (1-114)
  surat_mulai_nama   String?   // Nama surat mulai
  ayat_mulai         Int?
  surat_selesai      Int?      // Nomor surat (1-114)
  surat_selesai_nama String?   // Nama surat selesai
  ayat_selesai       Int?
  juz                Int?
  total_ayat         Int?

  // --- Khusus Hadits ---
  kitab_hadits       String?   // 'Hadits Arbain/Khamsin' | '150 Hadis Abu Hurairah Pilihan' | 'Hadits Bahjatul Qulub' | 'Hadits Bulughul Maram' | 'Hadits Riyadhush Shalihin' | 'Lainnya'
  hadits_no_mulai    Int?
  hadits_no_selesai  Int?
  total_hadits       Int?

  // --- Khusus Matan Ilmu ---
  nama_matan         String?   // 'Matan Jazariyyah' | 'Tuhfatul Athfal' | 'Jurumiyyah' | 'Alfiyah Ibnu Malik' | 'Baiquniyyah' | etc
  bait_mulai         Int?
  bait_selesai       Int?
  total_bait         Int?

  created_at         DateTime  @default(now())

  siswa              Siswa     @relation(fields: [siswa_id], references: [siswa_id], onDelete: Cascade)
  pegawai            Pegawai   @relation(fields: [pegawai_id], references: [pegawai_id], onDelete: Cascade)

  @@index([siswa_id])
  @@index([pegawai_id])
  @@index([kategori])
  @@index([tanggal])
  @@map("tahfidz_setoran")
}

model TahfidzHalaqah {
  halaqah_id      Int                   @id @default(autoincrement())
  nama_halaqah    String
  lembaga_id      Int
  pegawai_id      Int                   // Guru Tahfidz / Ustadz Pengampu
  tahun_id        Int?
  deskripsi       String?
  status          String                @default("Aktif") // 'Aktif' | 'Nonaktif'
  created_at      DateTime              @default(now())
  updated_at      DateTime              @updatedAt

  lembaga         Lembaga               @relation(fields: [lembaga_id], references: [lembaga_id], onDelete: Cascade)
  pegawai         Pegawai               @relation(fields: [pegawai_id], references: [pegawai_id], onDelete: Cascade)
  tahun_ajaran    TahunAjaran?          @relation(fields: [tahun_id], references: [tahun_id], onDelete: SetNull)
  anggota         TahfidzHalaqahSiswa[]

  @@index([lembaga_id])
  @@index([pegawai_id])
  @@map("tahfidz_halaqah")
}

model TahfidzHalaqahSiswa {
  id              Int                   @id @default(autoincrement())
  halaqah_id      Int
  siswa_id        Int
  created_at      DateTime              @default(now())

  halaqah         TahfidzHalaqah        @relation(fields: [halaqah_id], references: [halaqah_id], onDelete: Cascade)
  siswa           Siswa                 @relation(fields: [siswa_id], references: [siswa_id], onDelete: Cascade)

  @@unique([halaqah_id, siswa_id])
  @@index([halaqah_id])
  @@index([siswa_id])
  @@map("tahfidz_halaqah_siswa")
}

// ═══════════════════════════════════════════════════════
// MODUL KEUANGAN & PEMBAYARAN SANTRI
// ═══════════════════════════════════════════════════════

model PosPembayaran {
  pos_id           Int               @id @default(autoincrement())
  lembaga_id       Int?
  tahun_id         Int?
  nama_pos         String            // 'Uang Pangkal' | 'SPP Bulanan' | 'Kegiatan & Ujian' | 'Seragam & Perlengkapan' | dll
  kode_pos         String?           // 'PANGKAL' | 'SPP' | 'KEGIATAN' | 'SERAGAM'
  tipe_pembayaran  String            @default("Bulanan") // 'Bulanan' | 'Bebas' | 'Tahunan' | 'Sekali'
  deskripsi        String?
  is_active        Boolean           @default(true)
  created_at       DateTime          @default(now())

  lembaga          Lembaga?          @relation(fields: [lembaga_id], references: [lembaga_id], onDelete: Cascade)
  tahun_ajaran     TahunAjaran?      @relation(fields: [tahun_id], references: [tahun_id], onDelete: SetNull)
  tarif            TarifPembayaran[]
  tagihan          TagihanSiswa[]

  @@index([lembaga_id])
  @@index([tipe_pembayaran])
  @@map("pos_pembayaran")
}

model TarifPembayaran {
  tarif_id         Int            @id @default(autoincrement())
  pos_id           Int
  nama_tarif       String         // e.g. "Uang Pangkal - Kuota 1", "SPP Kelas VII", "Seragam Putra"
  kuota            String?        // 'Kuota 1' | 'Kuota 2' | 'Kuota 3' | null
  nominal          Float
  kelas_tingkat    Int?           // 7, 8, 9, 10, 11, 12, dll
  keterangan       String?
  created_at       DateTime       @default(now())

  pos              PosPembayaran  @relation(fields: [pos_id], references: [pos_id], onDelete: Cascade)

  @@index([pos_id])
  @@map("tarif_pembayaran")
}

model TagihanSiswa {
  tagihan_id       Int            @id @default(autoincrement())
  siswa_id         Int
  pos_id           Int
  tahun_id         Int?
  bulan            Int?           // 1 - 12 (untuk SPP)
  tahun_periode    Int?           // misal 2026
  nama_tagihan     String         // e.g. "SPP September 2026", "Uang Pangkal (Kuota 1)", "Kegiatan & Ujian TA 2026/2027"
  nominal_total    Float
  nominal_terbayar Float          @default(0)
  sisa_tagihan     Float
  status           String         @default("Belum Bayar") // 'Belum Bayar' | 'Sebagian' | 'Lunas'
  jatuh_tempo      String?        // YYYY-MM-DD
  keterangan       String?
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt

  siswa            Siswa          @relation(fields: [siswa_id], references: [siswa_id], onDelete: Cascade)
  pos              PosPembayaran  @relation(fields: [pos_id], references: [pos_id], onDelete: Cascade)
  tahun_ajaran     TahunAjaran?   @relation(fields: [tahun_id], references: [tahun_id], onDelete: SetNull)
  transaksi_items  PembayaranTransaksiItem[]

  @@index([siswa_id])
  @@index([pos_id])
  @@index([status])
  @@map("tagihan_siswa")
}

model RekeningPesantren {
  rekening_id      Int                     @id @default(autoincrement())
  lembaga_id       Int?
  nama_bank        String                  // 'Bank Syariah Indonesia (BSI)' | 'BCA' | 'BRI' | 'Mandiri'
  nomor_rekening   String
  atas_nama        String
  cabang           String?
  is_active        Boolean                 @default(true)
  created_at       DateTime                @default(now())

  lembaga          Lembaga?                @relation(fields: [lembaga_id], references: [lembaga_id], onDelete: SetNull)
  transaksi        PembayaranTransaksi[]

  @@map("rekening_pesantren")
}

model PembayaranTransaksi {
  transaksi_id            Int                       @id @default(autoincrement())
  nomor_transaksi         String                    @unique // TRX-YYYYMMDD-XXXX
  siswa_id                Int
  wali_id                 Int?
  tanggal_bayar           String                    // YYYY-MM-DD
  total_bayar             Float
  metode_pembayaran       String                    // 'Tunai / Loket' | 'Transfer Bank' | 'QRIS'
  rekening_tujuan_id      Int?
  bank_pengirim           String?
  nomor_rekening_pengirim String?
  atas_nama_pengirim      String?
  bukti_transfer_url      String?
  status                  String                    @default("Disetujui") // 'Menunggu Verifikasi' | 'Disetujui' | 'Ditolak'
  catatan                 String?
  alasan_penolakan        String?
  diterima_oleh_user_id   String?                   @db.Uuid
  waktu_verifikasi        DateTime?
  created_at              DateTime                  @default(now())
  updated_at              DateTime                  @updatedAt

  siswa                   Siswa                     @relation(fields: [siswa_id], references: [siswa_id], onDelete: Cascade)
  wali                    WaliMurid?                @relation(fields: [wali_id], references: [wali_id], onDelete: SetNull)
  rekening_tujuan         RekeningPesantren?        @relation(fields: [rekening_tujuan_id], references: [rekening_id], onDelete: SetNull)
  items                   PembayaranTransaksiItem[]

  @@index([siswa_id])
  @@index([status])
  @@index([tanggal_bayar])
  @@map("pembayaran_transaksi")
}

model PembayaranTransaksiItem {
  item_id          Int                 @id @default(autoincrement())
  transaksi_id     Int
  tagihan_id       Int
  nominal_bayar    Float

  transaksi        PembayaranTransaksi @relation(fields: [transaksi_id], references: [transaksi_id], onDelete: Cascade)
  tagihan          TagihanSiswa        @relation(fields: [tagihan_id], references: [tagihan_id], onDelete: Cascade)

  @@index([transaksi_id])
  @@index([tagihan_id])
  @@map("pembayaran_transaksi_item")
}

