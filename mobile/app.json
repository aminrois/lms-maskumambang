{
  "expo": {
    "name": "LMS Maskumambang",
    "slug": "lms-maskumambang",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.maskumambang.lms",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Aplikasi memerlukan izin Face ID untuk memudahkan login cepat dan aman."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4318FF",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.maskumambang.lms",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Izinkan LMS Maskumambang menggunakan Face ID untuk login cepat."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "8e586831-5523-417e-a567-3b972f307a06"
      }
    }
  }
}
